PORT=4000

# Either set DATABASE_URL, or the discrete PG* vars below are used as a fallback.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sehat_potli_backend
PGHOST=localhost
PGPORT=5432
PGDATABASE=sehat_potli_backend
PGUSER=postgres
PGPASSWORD=postgres

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — storefront + admin panel origins allowed to send credentialed requests
STORE_FRONT_URL=http://localhost:3000
STORE_FRONT_URL2=http://localhost:3001
STORE_ADMIN_URL=http://localhost:5174

# Resend (https://resend.com) — used to email OTP codes for customer signup verification.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Used to seed the one and only super admin via `npm run seed:admin`
SEED_ADMIN_NAME=Sehat Potli Admin
SEED_ADMIN_EMAIL=admin@sehatpotli.com
SEED_ADMIN_MOBILE=9876543210
SEED_ADMIN_PASSWORD=Admin@12345
