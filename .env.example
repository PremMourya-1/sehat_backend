PORT=4000

# Either set DATABASE_URL, or the discrete PG* vars below are used as a fallback.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sehat_potli_backend
PGHOST=localhost
PGPORT=5432
PGDATABASE=sehat_potli_backend
PGUSER=postgres
PGPASSWORD=postgres

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — storefront + admin panel origins allowed to send credentialed requests
STORE_FRONT_URL=http://localhost:3000
STORE_FRONT_URL2=http://localhost:3001
STORE_ADMIN_URL=http://localhost:5174

# Resend (https://resend.com) — used to email the 6-digit registration
# verification code (see utils/mailer.js) and all order-status emails (see
# utils/email.js). onboarding@resend.dev is Resend's sandbox domain — it
# only sends to the account's own signup email, never real customers, so
# this MUST be an address on a domain you've verified in Resend
# (resend.com/domains) before real customer emails will go out.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=orders@yourdomain.com
# Optional — if the from-address above has no real inbox behind it, set
# this so customer replies land somewhere you actually check.
RESEND_REPLY_TO=

# Shared secret between this API and the Next.js frontend's NextAuth adapter
# (src/lib/authAdapter.js) + internal issue-token endpoint. Never expose to
# a browser. Must match INTERNAL_API_SECRET in sehat-potli-front's env.
INTERNAL_API_SECRET=change_this_to_a_long_random_string

# Checkout mobile-number OTP provider — swappable. "console" just logs the
# OTP server-side (default, works with no account). Set to "msg91" or
# "2factor" once you have a real SMS provider account.
OTP_PROVIDER=console
MSG91_API_KEY=
MSG91_SENDER_ID=
TWOFACTOR_API_KEY=

# Used to seed the one and only super admin via `npm run seed:admin`
SEED_ADMIN_NAME=Sehat Potli Admin
SEED_ADMIN_EMAIL=admin@sehatpotli.com
SEED_ADMIN_MOBILE=9876543210
SEED_ADMIN_PASSWORD=Admin@12345

# AES-256-GCM key (64 hex chars = 32 bytes) used by utils/encryption.js to
# encrypt/decrypt third-party integration secrets stored in the
# IntegrationSettings table (see utils/shiprocket.js). Generate a new one
# per deployment with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change_this_to_a_64_char_hex_string

# Shiprocket (https://apiv2.shiprocket.in) — used to authenticate against the
# Shiprocket API (see utils/shiprocket.js). These are only read once, as a
# fallback to seed IntegrationSettings on first run if no row exists yet —
# after that, credentials live in the DB and are managed from the admin
# panel (Integrations > Shiprocket), not here. Safe to leave blank for a
# fresh clone; set them up from the admin panel instead.
SHIPROCKET_EMAIL=your_shiprocket_account_email
SHIPROCKET_PASSWORD=your_shiprocket_account_password

# Pickup location "nickname" exactly as registered under Shiprocket ->
# Settings -> Pickup Addresses. Not a secret, just config — same DB-first,
# .env-fallback pattern as above (see utils/shiprocket.js getPickupLocation).
SHIPROCKET_PICKUP_LOCATION=your_pickup_location_nickname

# Razorpay (https://dashboard.razorpay.com) webhook secret — configured
# separately from the Key ID/Key Secret pair, under Razorpay's own
# Settings -> Webhooks. Only read once, as a fallback to seed
# IntegrationSettings (for whichever mode — test/live — is currently active)
# on first read if not already set there — after that, it lives in the DB
# and is managed from the admin panel (Integrations > Razorpay), not here.
# Same DB-first, .env-fallback pattern as Shiprocket above (see
# utils/razorpay.js getRazorpayWebhookSecret). Safe to leave blank for a
# fresh clone; set it up from the admin panel instead.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloudinary (https://cloudinary.com) — image storage for every upload in
# the app (products, categories, hero banners, testimonials, blog posts,
# customer review photos — see middleware/upload.js). REQUIRED, no fallback:
# local disk storage isn't durable on Render (its filesystem is ephemeral —
# wiped on every restart/redeploy unless backed by a persistent disk), so
# unlike Shiprocket/Razorpay above this isn't optional first-time-setup
# convenience — uploads will fail without it. Get these three values from
# your Cloudinary dashboard (Settings -> API Keys) after signing up.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
